{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window. Least privilege (ADR-0010): no core plugin permissions beyond the event bridge, only the app commands it calls.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-app-ready",
    "allow-vault-create",
    "allow-vault-open",
    "allow-vault-open-default",
    "allow-vault-close",
    "allow-vault-info",
    "allow-undo",
    "allow-redo",
    "allow-types-list",
    "allow-fields-list",
    "allow-field-create",
    "allow-object-get",
    "allow-object-children",
    "allow-object-ancestors",
    "allow-object-summaries",
    "allow-objects-page",
    "allow-objects-count",
    "allow-object-search",
    "allow-backlinks",
    "allow-object-create",
    "allow-object-rename",
    "allow-object-set-prop",
    "allow-object-move",
    "allow-object-trash",
    "allow-object-restore",
    "allow-object-add-type",
    "allow-object-remove-type",
    "allow-blocks-list",
    "allow-blocks-apply",
    "allow-attachments-list",
    "allow-attachment-add",
    "allow-blob-read"
  ]
}
