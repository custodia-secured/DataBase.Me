{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window. Least privilege (ADR-0010): no core plugin permissions beyond the event bridge, only the app commands it calls.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-app-ready",
    "allow-vault-create",
    "allow-vault-open",
    "allow-vault-close",
    "allow-vault-info",
    "allow-types-list",
    "allow-object-get",
    "allow-object-children",
    "allow-object-create",
    "allow-object-rename",
    "allow-object-trash",
    "allow-object-restore",
    "allow-undo",
    "allow-redo"
  ]
}
